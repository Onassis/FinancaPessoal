import jakarta.persistence.*;
import lombok.Data;
import java.math.BigDecimal;
import java.time.LocalDate;

@Entity
@Data
@Table(uniqueConstraints = {
    @UniqueConstraint(columnNames = {"conta_id", "data"})
})
public class Saldo {
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(nullable = false)
    private LocalDate data;

    @ManyToOne(optional = false)
    @JoinColumn(name = "conta_id")
    private Conta conta;

    @Column(nullable = false)
    private BigDecimal saldoAnterior;

    @Column(nullable = false)
    private BigDecimal totalLancamento;

    // Método de conveniência para calcular o saldo final do dia
    @Transient // Não será persistido no banco
    public BigDecimal getSaldoFinalDoDia() {
        return this.saldoAnterior.add(this.totalLancamento);
    }
}
